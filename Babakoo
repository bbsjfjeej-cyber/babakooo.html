<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>عشق بابک و مهرناز</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    font-family: Tahoma, Arial, sans-serif;
    color: white;
    background: #12050b;
}

/* پس‌زمینه */
.background {
    position: fixed;
    inset: 0;
    z-index: -2;

    background:
        linear-gradient(
            rgba(20, 3, 12, 0.35),
            rgba(10, 2, 8, 0.88)
        ),
        url("background.png") center / cover no-repeat;
}

.background::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
        radial-gradient(
            circle at center,
            transparent 0%,
            rgba(0,0,0,.35) 65%,
            rgba(0,0,0,.75) 100%
        );
}

/* محتوای اصلی */
.container {
    width: min(1050px, 92%);
    margin: auto;
    padding: 40px 0 70px;
}

/* عنوان */
.hero {
    text-align: center;
    padding: 30px 10px;
}

.crown {
    font-size: 45px;
}

h1 {
    margin: 10px 0;
    font-size: clamp(35px, 7vw, 70px);
    text-shadow: 0 5px 25px black;
}

.subtitle {
    font-size: 17px;
    opacity: .9;
}

/* کارت */
.card {
    padding: 30px;
    border-radius: 28px;

    background: rgba(35, 8, 18, .72);

    border: 1px solid rgba(255, 215, 150, .35);

    backdrop-filter: blur(12px);

    box-shadow:
        0 20px 70px rgba(0,0,0,.5);
}

/* سه ورودی */
.inputs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
}

.box {
    padding: 25px 15px;
    text-align: center;

    border-radius: 22px;

    background: rgba(255,255,255,.06);

    border: 1px dashed rgba(255,220,170,.55);
}

.box h2 {
    margin: 5px 0 10px;
}

.box p {
    min-height: 40px;
    font-size: 13px;
    opacity: .75;
}

/* دکمه */
label {
    display: inline-block;

    cursor: pointer;

    padding: 12px 22px;

    border-radius: 999px;

    font-weight: bold;

    background:
        linear-gradient(
            135deg,
            #d99a35,
            #8e1e43
        );

    transition: .3s;
}

label:hover {
    transform: scale(1.05);
}

input {
    display: none;
}

/* نمایش فایل‌ها */
.preview {
    display: grid;
    gap: 20px;
    margin-top: 30px;
}

.item {
    padding: 15px;
    border-radius: 20px;
    background: rgba(0,0,0,.3);
}

.name {
    margin-bottom: 10px;
    font-weight: bold;
}

.item img,
.item video {
    width: 100%;
    max-height: 550px;

    object-fit: contain;

    border-radius: 18px;

    background: #050205;
}

/* پایین سایت */
footer {
    text-align: center;
    margin-top: 25px;
    opacity: .65;
    font-size: 13px;
}

/* موبایل */
@media (max-width: 750px) {

    .inputs {
        grid-template-columns: 1fr;
    }

    .container {
        padding-top: 15px;
    }

    .card {
        padding: 20px;
    }
}
</style>
</head>


<body>

<div class="background"></div>

<div class="container">

    <!-- عنوان سایت -->
    <section class="hero">

        <div class="crown">
            ♛ ♥ ♛
        </div>

        <h1>
            عشق بابک و مهرناز
        </h1>

        <div class="subtitle">
            گوشه‌ای برای ثبت خاطرات، عکس‌ها، GIFها و فیلم‌های دو نفره ❤️
        </div>

    </section>


    <!-- بخش آپلود -->
    <section class="card">

        <div class="inputs">


            <!-- عکس -->
            <div class="box">

                <h2>📷 عکس</h2>

                <p>
                    عکس‌های خاطره‌انگیزتان را انتخاب کنید.
                </p>

                <label for="photo">
                    انتخاب عکس
                </label>

                <input
                    id="photo"
                    type="file"
                    accept="image/*"
                >

            </div>


            <!-- GIF -->
            <div class="box">

                <h2>✨ GIF</h2>

                <p>
                    گیف‌های عاشقانه و بامزه را اضافه کنید.
                </p>

                <label for="gif">
                    انتخاب GIF
                </label>

                <input
                    id="gif"
                    type="file"
                    accept="image/gif"
                >

            </div>


            <!-- فیلم -->
            <div class="box">

                <h2>🎬 فیلم</h2>

                <p>
                    فیلم‌های خاطره‌انگیزتان را انتخاب کنید.
                </p>

                <label for="video">
                    انتخاب فیلم
                </label>

                <input
                    id="video"
                    type="file"
                    accept="video/*"
                >

            </div>

        </div>


        <!-- محل نمایش فایل‌ها -->
        <div
            id="preview"
            class="preview">
        </div>

    </section>


    <footer>
        ساخته شده برای خاطره‌های بابک و مهرناز ❤️
    </footer>

</div>


<script>

const preview =
    document.getElementById("preview");


function addFile(input, type) {

    input.addEventListener("change", function () {

        const file = input.files[0];

        if (!file) return;


        const url =
            URL.createObjectURL(file);


        const item =
            document.createElement("div");

        item.className = "item";


        const title =
            document.createElement("div");

        title.className = "name";


        if (type === "video") {

            title.textContent =
                "🎬 فیلم انتخاب‌شده";

        }

        else if (type === "gif") {

            title.textContent =
                "✨ GIF انتخاب‌شده";

        }

        else {

            title.textContent =
                "📷 عکس انتخاب‌شده";

        }


        item.appendChild(title);


        if (type === "video") {

            const video =
                document.createElement("video");

            video.src = url;

            video.controls = true;

            video.playsInline = true;

            item.appendChild(video);

        }

        else {

            const image =
                document.createElement("img");

            image.src = url;

            image.alt =
                "فایل انتخاب‌شده";

            item.appendChild(image);

        }


        preview.prepend(item);

    });

}


/* فعال کردن سه ورودی */

addFile(
    document.getElementById("photo"),
    "photo"
);

addFile(
    document.getElementById("gif"),
    "gif"
);

addFile(
    document.getElementById("video"),
    "video"
);

</script>

</body>
</html>
